# stiefelhelden.de -> https://www.stiefelhelden.de (in einem Schritt, Pfad und Parameter bleiben).
# Greift nur für die echte Domain, lokal unter DDEV passiert nichts.
<IfModule mod_rewrite.c>
  RewriteEngine On
  RewriteCond %{HTTP_HOST} ^stiefelhelden\.de$ [NC]
  RewriteRule ^ https://www.stiefelhelden.de%{REQUEST_URI} [R=301,L]
</IfModule>

# data.js ändert sich beim Speichern im Backend – Browser sollen jedes Mal nachfragen
<Files "data.js">
  <IfModule mod_headers.c>
    Header set Cache-Control "no-cache"
  </IfModule>
</Files>

# Versteckte Dateien (.git, .ddev, .idea …) nicht ausliefern
RedirectMatch 404 /\.(?!well-known)
